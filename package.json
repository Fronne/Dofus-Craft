{
  "name": "dofus-craft",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "worker:db:init": "wrangler d1 execute dofus-craft-community-prices --config worker/wrangler.toml --file worker/schema.sql --remote",
    "worker:db:migrate-device-id": "wrangler d1 execute dofus-craft-community-prices --config worker/wrangler.toml --file worker/migrations/0001_add_device_id.sql --remote",
    "worker:db:migrate-visits": "wrangler d1 execute dofus-craft-community-prices --config worker/wrangler.toml --file worker/migrations/0002_add_app_visits.sql --remote",
    "worker:db:migrate-outlier-tracking": "wrangler d1 execute dofus-craft-community-prices --config worker/wrangler.toml --file worker/migrations/0003_add_outlier_tracking.sql --remote",
    "worker:db:migrate-player-counters": "wrangler d1 execute dofus-craft-community-prices --config worker/wrangler.toml --file worker/migrations/0004_add_player_counters.sql --remote",
    "worker:db:migrate-info-message": "wrangler d1 execute dofus-craft-community-prices --config worker/wrangler.toml --file worker/migrations/0006_add_info_message.sql --remote",
    "worker:db:migrate-contribution-kind": "wrangler d1 execute dofus-craft-community-prices --config worker/wrangler.toml --file worker/migrations/0005_add_contribution_kind.sql --remote",
    "worker:db:migrate-forgemagie": "wrangler d1 execute dofus-craft-community-prices --config worker/wrangler.toml --file worker/migrations/0007_add_forgemagie.sql --remote",
    "worker:db:migrate-fm-items": "wrangler d1 execute dofus-craft-community-prices --config worker/wrangler.toml --file worker/migrations/0008_add_fm_items.sql --remote",
    "worker:db:migrate-site-sessions": "wrangler d1 execute dofus-craft-community-prices --config worker/wrangler.toml --file worker/migrations/0009_add_site_sessions.sql --remote",
    "worker:db:migrate-fm-channels": "wrangler d1 execute dofus-craft-community-prices --config worker/wrangler.toml --file worker/migrations/0010_add_fm_channels.sql --remote",
    "worker:db:migrate-external-prices": "wrangler d1 execute dofus-craft-community-prices --config worker/wrangler.toml --file worker/migrations/0011_add_external_prices.sql --remote",
    "worker:db:migrate-fm-guild": "wrangler d1 execute dofus-craft-community-prices --config worker/wrangler.toml --file worker/migrations/0012_add_fm_guild.sql --remote",
    "worker:db:migrate-line-corrections": "wrangler d1 execute dofus-craft-community-prices --config worker/wrangler.toml --file worker/migrations/0013_add_line_corrections.sql --remote",
    "worker:db:migrate-line-read-name": "wrangler d1 execute dofus-craft-community-prices --config worker/wrangler.toml --file worker/migrations/0014_add_line_read_name_and_counted.sql --remote",
    "worker:db:migrate-channel-commands": "wrangler d1 execute dofus-craft-community-prices --config worker/wrangler.toml --file worker/migrations/0015_add_channel_commands.sql --remote",
    "worker:db:migrate-site-settings": "wrangler d1 execute dofus-craft-community-prices --config worker/wrangler.toml --file worker/migrations/0016_add_site_settings.sql --remote",
    "worker:db:migrate-hdv-page-setting": "wrangler d1 execute dofus-craft-community-prices --config worker/wrangler.toml --file worker/migrations/0017_add_hdv_page_setting.sql --remote",
    "worker:db:migrate-sniffer-tables": "wrangler d1 execute dofus-craft-community-prices --config worker/wrangler.toml --file worker/migrations/0018_add_sniffer_tables.sql --remote",
    "worker:db:migrate-sniffer-origin": "wrangler d1 execute dofus-craft-community-prices --config worker/wrangler.toml --file worker/migrations/0019_add_sniffer_origin.sql --remote",
    "worker:db:migrate-lot-prices": "wrangler d1 execute dofus-craft-community-prices --config worker/wrangler.toml --file worker/migrations/0020_add_lot_prices.sql --remote",
    "worker:db:migrate-brisage-coefficients": "wrangler d1 execute dofus-craft-community-prices --config worker/wrangler.toml --file worker/migrations/0021_add_brisage_coefficients.sql --remote",
    "worker:db:migrate-dashboard-indexes": "wrangler d1 execute dofus-craft-community-prices --config worker/wrangler.toml --file worker/migrations/0022_add_dashboard_indexes.sql --remote",
    "admin:dev": "vite --config vite.admin.config.ts",
    "admin:build": "vite build --config vite.admin.config.ts",
    "admin:deploy": "wrangler deploy --config admin-worker/wrangler.toml"
  },
  "dependencies": {
    "@fontsource-variable/lexend": "^5.3.0",
    "@fontsource/rowdies": "^5.3.0",
    "jose": "^6.2.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260916.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "24.1.3",
    "prettier": "3.9.6",
    "typescript": "5.7.3",
    "typescript-eslint": "8.70.0",
    "vite": "5.4.21",
    "vitest": "2.1.9",
    "wrangler": "^4.132.0"
  }
}
