{
  "name": "dofus-craft",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "worker:db:init": "wrangler d1 execute dofus-craft-community-prices --config worker/wrangler.toml --file worker/schema.sql --remote",
    "worker:db:migrate-device-id": "wrangler d1 execute dofus-craft-community-prices --config worker/wrangler.toml --file worker/migrations/0001_add_device_id.sql --remote",
    "worker:db:migrate-visits": "wrangler d1 execute dofus-craft-community-prices --config worker/wrangler.toml --file worker/migrations/0002_add_app_visits.sql --remote"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260916.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "24.1.3",
    "prettier": "3.9.6",
    "typescript": "5.7.3",
    "typescript-eslint": "8.70.0",
    "vite": "5.4.21",
    "vitest": "2.1.9",
    "wrangler": "^4.132.0"
  }
}
