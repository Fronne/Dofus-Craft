# Community price sharing (specs/004-community-price-sharing). Points to a Supabase project
# provisioned with db/community-price-sharing/schema.sql. VITE_COMMUNITY_API_KEY is the project's
# public "anon" key — safe to expose client-side, the schema's Row Level Security policies are
# what actually protect the data, not the key's secrecy.
VITE_COMMUNITY_API_URL=https://your-project.supabase.co/rest/v1
VITE_COMMUNITY_API_KEY=your-anon-key
